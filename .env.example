# =====================================================
# Frontend (.env in project root — Vite reads these)
# =====================================================
# URL of your deployed Express API (leave empty to use Vite proxy in dev)
VITE_API_URL=https://your-api-server.com


# =====================================================
# Backend (server/.env)
# =====================================================
PORT=3001

# CORS — set to your Firebase Hosting URL in production
ALLOWED_ORIGIN=https://pmgi-school-of-ministry.web.app

# SMTP — Gmail: enable App Passwords and paste the 16-char password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=pmgischoolofministry2026@gmail.com
SMTP_PASS=your_gmail_app_password_here
