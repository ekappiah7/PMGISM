# ======================================================
# PMGI School of Ministry — Environment Variables
# ======================================================
# Copy this file to .env and fill in your values

# Server
PORT=3000

# SMTP Email Configuration
# For Gmail: enable "App Passwords" under your Google Account security settings
# and paste the 16-character app password below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=pmgischoolofministry2026@gmail.com
SMTP_PASS=your_app_password_here
